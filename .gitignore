outputs/tables/*.txt
# Everything under outputs/tables is regenerable by re-running the stage that wrote it.
outputs/tables/**/*.csv
# Ledger identity sidecars (<ledger>.meta.json, event_study.open_ledger) and
# result sidecars (30_confirmatory_run.py). Regenerable with the ledger they
# describe; a sidecar without its ledger is meaningless.
outputs/tables/*.json
outputs/tables/**/*.json
outputs/*.pptx

# OS
.DS_Store
Thumbs.db

# Keep directory structure with .gitkeep
!**/.gitkeep
data/processed/ems_pages/

# Local virtualenv
.venv/

# Wikipedia probe cache (regenerable; scripts/21_refetch_wikipedia.py)
data/processed/wiki_probe_cache/

# Wikipedia category cache (regenerable; scripts/24_build_wiki_basket.py)
data/processed/wiki_cat_cache/

# Wikidata SPARQL response cache (regenerable)
data/processed/wikidata_cache/

# Wikidata entity cache, one file per article (regenerable; 26_resolve_basket_scope.py).
data/processed/wikidata_entity_cache/

# Cross-process pacing state for the shared Wikimedia rate-limit bucket
# (scripts/wikimedia.py). Runtime state, never input.
data/processed/wikimedia_state/

# Wikipedia pageviews cache, one file per title-series (regenerable;
# 11_fetch_awareness_components.py). Fetched from the REST pageviews API, which
# is replayable, so the bytes are not evidence of anything the code cannot
# re-derive; caching exists only so a rate-limit interruption does not cost the
# whole basket.
data/processed/wiki_pageviews_cache/

# ops runner state (PID files, step logs, sentinels)
ops/state/

# Personal notes, kept locally.
vault/
