\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Distribution of Mental Health Call Share by Awareness Quintiles. The figure shows box plots of mh\_share for each awareness quintile, revealing the distribution of outcomes across different levels of awareness. The top quintile shows the strongest positive effects in regression analysis.}}{17}{figure.caption.15}\protected@file@percent }
\newlabel{fig:quantile_boxplots}{{8}{17}{Distribution of Mental Health Call Share by Awareness Quintiles. The figure shows box plots of mh\_share for each awareness quintile, revealing the distribution of outcomes across different levels of awareness. The top quintile shows the strongest positive effects in regression analysis}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.8.2}Forward-Looking Lag Analysis}{17}{subsubsection.5.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Forward-Looking Lag Analysis: Effects of Awareness on Future Mental Health Calls. The figure shows how awareness on day $t$ affects mh\_share on days $t+1$ through $t+7$. The smaller magnitude of forward effects compared to backward effects supports the causal interpretation.}}{18}{figure.caption.16}\protected@file@percent }
\newlabel{fig:forward_lag}{{9}{18}{Forward-Looking Lag Analysis: Effects of Awareness on Future Mental Health Calls. The figure shows how awareness on day $t$ affects mh\_share on days $t+1$ through $t+7$. The smaller magnitude of forward effects compared to backward effects supports the causal interpretation}{figure.caption.16}{}}
