\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Heterogeneous Effects by \% Black Quartiles. The figure shows the 7-day lag coefficient (with 95\% confidence intervals) for each quartile of \% Black. Q1 represents districts with the lowest \% Black, Q4 represents districts with the highest \% Black. The effect decreases monotonically and becomes negative in Q4.}}{15}{figure.caption.11}\protected@file@percent }
\newlabel{fig:hetero_black}{{4}{15}{Heterogeneous Effects by \% Black Quartiles. The figure shows the 7-day lag coefficient (with 95\% confidence intervals) for each quartile of \% Black. Q1 represents districts with the lowest \% Black, Q4 represents districts with the highest \% Black. The effect decreases monotonically and becomes negative in Q4}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Heterogeneous Effects by \% Hispanic Quartiles. The figure shows the 7-day lag coefficient (with 95\% confidence intervals) for each quartile of \% Hispanic. Q1 represents districts with the lowest \% Hispanic, Q4 represents districts with the highest \% Hispanic. The effect decreases but remains positive across all quartiles.}}{15}{figure.caption.12}\protected@file@percent }
\newlabel{fig:hetero_hispanic}{{5}{15}{Heterogeneous Effects by \% Hispanic Quartiles. The figure shows the 7-day lag coefficient (with 95\% confidence intervals) for each quartile of \% Hispanic. Q1 represents districts with the lowest \% Hispanic, Q4 represents districts with the highest \% Hispanic. The effect decreases but remains positive across all quartiles}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Heterogeneous Effects by \% White Quartiles. The figure shows the 7-day lag coefficient (with 95\% confidence intervals) for each quartile of \% White. Q1 represents districts with the lowest \% White, Q4 represents districts with the highest \% White. The effect increases with \% White, with Q4 showing the strongest positive effect.}}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:hetero_white}{{6}{16}{Heterogeneous Effects by \% White Quartiles. The figure shows the 7-day lag coefficient (with 95\% confidence intervals) for each quartile of \% White. Q1 represents districts with the lowest \% White, Q4 represents districts with the highest \% White. The effect increases with \% White, with Q4 showing the strongest positive effect}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Heterogeneous Effects by \% Asian Quartiles. The figure shows the 7-day lag coefficient (with 95\% confidence intervals) for each quartile of \% Asian. Q1 represents districts with the lowest \% Asian, Q4 represents districts with the highest \% Asian. The effect increases with \% Asian, similar to the pattern for \% White.}}{16}{figure.caption.14}\protected@file@percent }
\newlabel{fig:hetero_asian}{{7}{16}{Heterogeneous Effects by \% Asian Quartiles. The figure shows the 7-day lag coefficient (with 95\% confidence intervals) for each quartile of \% Asian. Q1 represents districts with the lowest \% Asian, Q4 represents districts with the highest \% Asian. The effect increases with \% Asian, similar to the pattern for \% White}{figure.caption.14}{}}
